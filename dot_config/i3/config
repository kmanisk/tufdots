# Enable Ctrl+Alt+Backspace emergency shortcut to immediately kill hung Xorg
exec_always --no-startup-id setxkbmap -option terminate:ctrl_alt_bksp

# Emergency game kill switch: Ctrl+Alt+Delete terminates CS2, Gamescope, Steam
bindsym Control+Mod1+Delete exec --no-startup-id ~/.local/bin/killgame

exec_always --no-startup-id ~/.local/bin/setup-display
#exec xrandr --auto --output HDMI-1 --mode 1920x1080 --above HDMI-2

exec_always --no-startup-id sh -c 'sleep 0.5 && ~/.fehbg'

exec --no-startup-id dunst
# exec --no-startup-id picom -b # Disabled globally
exec --no-startup-id ~/.local/bin/auto-nightlight
exec --no-startup-id blueman-applet
# Alacritty scratch terminal - spawns once on login straight into scratchpad
exec --no-startup-id alacritty --class Alacritty,scratch-term
# Notes scratchpad - nvim with notes.md, spawns once on login straight into scratchpad
exec --no-startup-id alacritty --class Alacritty,scratch-notes -e nvim /home/manisk/notes.md
# Autotiling: automatically switch horizontal/vertical splits based on focused window dimensions
exec_always --no-startup-id sh -c 'pkill -x autotiling; sleep 0.2; exec autotiling'
# CS2 Window Restack Hook: forces CS2 to top of stacking order on workspace focus
exec_always --no-startup-id sh -c 'pkill -f cs2-restack-hook; sleep 0.2; exec ~/.local/bin/cs2-restack-hook'
# Auto-restore previous workspace session on login / startup
exec --no-startup-id sh -c 'sleep 1.2 && ~/.local/bin/i3-session-restore --all'
exec_always --no-startup-id gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec_always --no-startup-id gsettings set org.gnome.desktop.interface gtk-theme 'cachyos-nord'
exec_always --no-startup-id gsettings set org.gnome.desktop.interface text-scaling-factor 1.2
exec_always --no-startup-id gsettings set org.gnome.desktop.interface font-name 'CommitMono Nerd Font 11'
exec_always --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id ~/.local/bin/auto-power-profile
exec --no-startup-id ~/.local/bin/auto-power-profile --daemon

# Toggle Compositor (Picom) for competitive gaming (Alt + Shift + o)
bindsym Mod1+Shift+o exec --no-startup-id "pkill picom && notify-send -t 1500 'Picom' 'Compositor Disabled (Gaming Mode)' || (picom -b && notify-send -t 1500 'Picom' 'Compositor Enabled')"

exec_always mkfifo /tmp/xobpipe && tail -f /tmp/xobpipe | xob -t 2170 & disown
