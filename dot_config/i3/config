bindsym XF86AudioRaiseVolume exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioLowerVolume exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"
# mute sound
bindsym XF86AudioMute exec "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"

# Screen Brightness (Hardware keys & xremap)
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/bin/change-brightness +5%
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/bin/change-brightness 5%-

bindsym $mod+c exec gnome-calculator
#bindsym $mod+p exec ~/.scripts/dmshot

# Random Wallpaper Switcher (Gaming, Creepy, Creative, Nature)
bindsym Mod1+Shift+w exec --no-startup-id ~/.local/bin/random-wallpaper
bindsym Mod1+Control+w exec --no-startup-id ~/.local/bin/wallpaper-menu
# Toggle Bottom Bar (Polybar) (Alt + 0)
bindsym Mod1+0 exec --no-startup-id ~/.local/bin/toggle-bar

