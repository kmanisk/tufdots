set $mod Mod4
font pango:Iosevka Nerd Font 13
floating_modifier $mod

# ==============================================================================
# TERMINAL & APPLICATION LAUNCHERS
# ==============================================================================
set $term alacritty
bindsym Mod1+Return exec $term
bindsym $mod+Return exec $term

# App Launcher (Rofi)
bindsym Mod1+space exec "pkill rofi || rofi -show drun"
bindsym $mod+d exec "pkill rofi || rofi -show drun"

# Browser (Windows + Shift + b) -> Default Brave on Intel iGPU (Workspace 2)
bindsym $mod+Shift+b workspace number $ws2; exec brave-origin

# Browser on NVIDIA GPU (Windows + Alt + b) -> Brave on RTX 5050 (Vulkan)
bindsym $mod+Mod1+b workspace number $ws2; exec brave-nvidia

# Text Editor
bindsym $mod+Shift+t exec $term -e nvim

# File Manager
bindsym $mod+e exec thunar

# Spotify (Windows + m)
bindsym $mod+m exec spotify

# Steam (Alt + Shift + s) - gaming workspace 5; starts Steam only if not running
bindsym Mod1+Shift+s exec --no-startup-id ~/.local/bin/steam-workspace

# Task Manager (TMOG in floating window)
bindsym Control+Shift+Escape exec --no-startup-id /usr/bin/TaskManagerOG

# ==============================================================================
# SYSTEM UTILITIES
# ==============================================================================
bindsym $mod+Mod1+1 exec $term --class nmtui -e nmtui
bindsym $mod+Mod1+2 exec blueman-manager
bindsym $mod+Mod1+3 exec pavucontrol
bindsym $mod+Shift+s exec --no-startup-id ~/.local/bin/screenshot-region
bindsym $mod+Control+p exec --no-startup-id ~/.local/bin/toggle-audio-sink
bindsym Mod1+Shift+n exec --no-startup-id ~/.local/bin/toggle-nightlight

# Alt + Shift + { (increase / cooler) & Alt + Shift + " (decrease / warmer)
bindsym Mod1+Shift+braceleft exec --no-startup-id ~/.local/bin/adjust-nightlight +250
bindsym Mod1+Shift+bracketleft exec --no-startup-id ~/.local/bin/adjust-nightlight +250
bindsym Mod1+Shift+quotedbl exec --no-startup-id ~/.local/bin/adjust-nightlight -250
bindsym Mod1+Shift+apostrophe exec --no-startup-id ~/.local/bin/adjust-nightlight -250

# Ctrl + Shift + { & Ctrl + Shift + "
bindsym Control+Shift+braceleft exec --no-startup-id ~/.local/bin/adjust-nightlight +250
bindsym Control+Shift+bracketleft exec --no-startup-id ~/.local/bin/adjust-nightlight +250
bindsym Control+Shift+quotedbl exec --no-startup-id ~/.local/bin/adjust-nightlight -250
bindsym Control+Shift+apostrophe exec --no-startup-id ~/.local/bin/adjust-nightlight -250

# Screen Lock (Windows + Ctrl + l)
bindsym $mod+Control+l exec "sleep 0.1 && i3lock --blur 5"

# ==============================================================================
# WINDOW MANAGEMENT
# ==============================================================================
# Kill / Close window (Windows + q & Windows + Shift + q)
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# Smart Layout Toggle: Toggle between Tiling and Tabbed mode
# Bound to Windows + semicolon (comfortable right-hand home row) & Windows + a
bindsym $mod+semicolon exec --no-startup-id ~/.local/bin/smart-layout-toggle
bindsym $mod+a exec --no-startup-id ~/.local/bin/smart-layout-toggle
bindsym $mod+w layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+a focus parent

# Split orientation
bindsym $mod+b split h
bindsym $mod+v split v

# ==============================================================================
# FOCUS MOVEMENT (Windows + hjkl & Arrows)
# ==============================================================================
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# ==============================================================================
# WINDOW MOVEMENT (Windows + Shift + hjkl)
# ==============================================================================
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ==============================================================================
# WINDOW RESIZING (Mod + Arrows)
# ==============================================================================

bindsym $mod+Right resize grow width 30 px or 3 ppt
bindsym $mod+Left resize shrink width 30 px or 3 ppt
bindsym $mod+Up resize shrink height 30 px or 3 ppt
bindsym $mod+Down resize grow height 30 px or 3 ppt

# Modal resize
mode "resize" {
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+Shift+m mode "resize"

# ==============================================================================
# WORKSPACE MANAGEMENT
# ==============================================================================
# Define names for default workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Top-Row Right-Hand Workspace Switching (Windows + u i o p)
bindsym $mod+u workspace number $ws1
bindsym $mod+i workspace number $ws2
bindsym $mod+o workspace number $ws3
bindsym $mod+p workspace number $ws4

# Top-Row Right-Hand Move Window + follow it (Windows + Shift + u i o p)
bindsym $mod+Shift+u move container to workspace number $ws1; workspace number $ws1
bindsym $mod+Shift+i move container to workspace number $ws2; workspace number $ws2
bindsym $mod+Shift+o move container to workspace number $ws3; workspace number $ws3
bindsym $mod+Shift+p move container to workspace number $ws4; workspace number $ws4

# Standard Number Workspace Switching (Windows + 1..0)
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move Window to Workspace (Windows + Shift + 1..0 & Windows + Ctrl + 1..0)
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Control+1 move container to workspace number $ws1
bindsym $mod+Control+2 move container to workspace number $ws2
bindsym $mod+Control+3 move container to workspace number $ws3
bindsym $mod+Control+4 move container to workspace number $ws4
bindsym $mod+Control+5 move container to workspace number $ws5
bindsym $mod+Control+6 move container to workspace number $ws6
bindsym $mod+Control+7 move container to workspace number $ws7
bindsym $mod+Control+8 move container to workspace number $ws8
bindsym $mod+Control+9 move container to workspace number $ws9
bindsym $mod+Control+0 move container to workspace number $ws10

# Sequential Workspace Navigation (Windows + , and . [< and >])
bindsym $mod+comma workspace prev
bindsym $mod+period workspace next
bindsym $mod+Shift+comma move container to workspace prev; workspace prev
bindsym $mod+Shift+period move container to workspace next; workspace next

# Back and Forth with last workspace
bindsym $mod+Tab workspace back_and_forth

# Scratchpad dropdowns - toggle scripts spawn the window if it was closed,
# so the keys never go silently dead (plain `scratchpad show` can't do that)
bindsym Control+space exec --no-startup-id ~/.local/bin/scratch-toggle term
bindsym $mod+n exec --no-startup-id ~/.local/bin/scratch-toggle notes

# ==============================================================================
# SESSION & CONFIG RELOAD (with i3-resurrect session manager)
# ==============================================================================
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Safe session save / restore (Alt + Shift + Numbers):
# Alt + Shift + 7 : Save all active workspaces session
# Alt + Shift + 8 : Restore all workspaces session
# Alt + Shift + 9 : Session Manager interactive menu
bindsym Mod1+Shift+7 exec --no-startup-id ~/.local/bin/i3-session-save --all
bindsym Mod1+Shift+8 exec --no-startup-id ~/.local/bin/i3-session-restore --all
bindsym Mod1+Shift+9 exec --no-startup-id ~/.local/bin/i3-session-menu

# Per-workspace quick save / restore (Alt + Ctrl + Numbers):
bindsym Mod1+Control+7 exec --no-startup-id ~/.local/bin/i3-session-save
bindsym Mod1+Control+8 exec --no-startup-id ~/.local/bin/i3-session-restore

# Power / Shutdown Menu (Windows + Escape & Windows + Shift + e)
bindsym $mod+Escape exec --no-startup-id ~/.local/bin/powermenu
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/powermenu


#
# Status Bar:
#
exec_always --no-startup-id ~/.config/polybar/launch.sh

