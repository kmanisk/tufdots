/**
 * Balanced Centered Floating Modal Theme for Rofi Clipboard (Gruvbox Dark)
 */
@import "~/.config/rofi/gruvbox-colors.rasi"

configuration {
    show-icons: false;
}

window {
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @border-focus;
    border-radius:       12px;
    width:               1150px;
    location:            center;
    anchor:              center;
    padding:             18px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, message, listview ];
    spacing:             12px;
}

inputbar {
    background-color:    @background-alt;
    border-radius:       8px;
    padding:             10px 16px;
    children:            [ prompt, entry ];
    spacing:             12px;
}

prompt {
    background-color:    transparent;
    text-color:          @accent-bright;
    font:                "Iosevka Nerd Font Bold 16";
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    placeholder:         "Filter clipboard history...";
    placeholder-color:   @foreground-alt;
    font:                "Iosevka Nerd Font 16";
}

message {
    background-color:    @background-alt;
    border-radius:       6px;
    padding:             6px 12px;
}

textbox {
    background-color:    transparent;
    text-color:          @accent-bright;
    font:                "Iosevka Nerd Font SemiBold 14";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               12;
    spacing:             6px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
}

element {
    background-color:    transparent;
    text-color:          @foreground;
    border-radius:       6px;
    padding:             8px 14px;
    children:            [ element-text ];
}

element selected {
    background-color:    @accent;
    text-color:          #1d2021;
}

element-text {
    background-color:    inherit;
    text-color:          inherit;
    font:                "Iosevka Nerd Font 15";
}
