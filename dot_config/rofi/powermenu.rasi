/**
 * Modern Power Menu for Rofi (i3/X11 style)
 */
configuration {
    show-icons: false;
}

* {
    background:          #0f141ce6;
    background-alt:      #1b222d;
    foreground:          #e5e9f0;
    selected:            #81a1c1;
    selected-text:       #0f141c;
    border-col:          #2e3440;
    font:                "Iosevka Nerd Font 13";
}

window {
    transparency:        "real";
    background-color:    @background;
    text-color:          @foreground;
    border:              2px;
    border-color:        @border-col;
    border-radius:       12px;
    width:               360px;
    location:            center;
    anchor:              center;
    padding:             16px;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, listview ];
    spacing:             12px;
}

inputbar {
    background-color:    transparent;
    children:            [ prompt ];
}

prompt {
    background-color:    @background-alt;
    text-color:          @selected;
    padding:             8px 14px;
    border-radius:       8px;
    font:                "Iosevka Nerd Font Bold 13";
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               5;
    spacing:             8px;
    cycle:               true;
    dynamic:             true;
    layout:              vertical;
}

element {
    background-color:    @background-alt;
    text-color:          @foreground;
    orientation:         horizontal;
    border-radius:       8px;
    padding:             10px 14px;
    cursor:              pointer;
}

element selected.normal {
    background-color:    @selected;
    text-color:          @selected-text;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
    vertical-align:      0.5;
}
