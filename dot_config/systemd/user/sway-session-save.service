[Unit]
Description=Auto-save Sway session on shutdown, reboot or logout
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target exit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=%h/.local/bin/sway-session-save --all --quiet
TimeoutStopSec=15

[Install]
WantedBy=default.target
