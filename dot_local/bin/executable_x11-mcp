#!/usr/bin/env python3
"""
x11-mcp: Model Context Protocol server for X11 session, display, and input inspection
Complies with OpenCode / Antigravity JSON-RPC 2.0 stdio MCP specification.
"""
import json
import os
import subprocess
import sys

def run_cmd(cmd, timeout=10):
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if res.returncode != 0:
            return {"error": res.stderr.strip() or f"Exit {res.returncode}"}
        return res.stdout.strip()
    except Exception as e:
        return {"error": str(e)}

def x11_session_info():
    return {
        "session_type": os.environ.get("XDG_SESSION_TYPE", "unknown"),
        "display": os.environ.get("DISPLAY", ":0"),
        "current_desktop": os.environ.get("XDG_CURRENT_DESKTOP", "unknown"),
        "xauthority": os.environ.get("XAUTHORITY", "")
    }

def x11_list_outputs():
    raw = run_cmd(["xrandr", "--query"])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    outputs = []
    for line in raw.splitlines():
        if " connected" in line:
            parts = line.split()
            outputs.append({
                "name": parts[0],
                "status": "connected",
                "primary": "primary" in parts,
                "mode_line": line
            })
    return {"outputs": outputs}

def x11_display_info():
    raw = run_cmd(["xdpyinfo"])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    summary = {}
    for line in raw.splitlines():
        if "dimensions:" in line:
            summary["dimensions"] = line.strip().split("dimensions:")[1].strip()
        elif "resolution:" in line:
            summary["resolution"] = line.strip().split("resolution:")[1].strip()
        elif "default screen number:" in line:
            summary["default_screen"] = line.strip().split("default screen number:")[1].strip()
    return summary

def x11_active_window():
    wid = run_cmd(["xdotool", "getactivewindow"])
    if isinstance(wid, dict) and "error" in wid:
        return wid
    wid = wid.strip()
    wname = run_cmd(["xdotool", "getwindowname", wid])
    wpid = run_cmd(["xdotool", "getwindowpid", wid])
    wgeom = run_cmd(["xdotool", "getwindowgeometry", wid])
    return {
        "window_id": wid,
        "title": wname if isinstance(wname, str) else "",
        "pid": wpid if isinstance(wpid, str) else "",
        "geometry": wgeom if isinstance(wgeom, str) else ""
    }

def x11_window_properties(window_id=None):
    cmd = ["xprop"]
    if window_id:
        cmd += ["-id", str(window_id)]
    else:
        cmd += ["-root"]
    raw = run_cmd(cmd)
    if isinstance(raw, dict) and "error" in raw:
        return raw
    props = {}
    for line in raw.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            props[k.strip()] = v.strip()
    return props

def x11_list_input_devices():
    raw = run_cmd(["xinput", "list", "--name-only"])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    devices = [d.strip() for d in raw.splitlines() if d.strip()]
    return {"devices": devices}

def x11_keyboard_state():
    raw = run_cmd(["xset", "q"])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    return {"raw_state": raw}

TOOLS = [
    {
        "name": "x11_session_info",
        "description": "Get current X11 display session variables ($DISPLAY, $XDG_SESSION_TYPE, etc.).",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "x11_list_outputs",
        "description": "List connected display outputs and resolutions via xrandr.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "x11_display_info",
        "description": "Get overall X11 display dimensions, DPI, and default screen number.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "x11_active_window",
        "description": "Get currently active window ID, name, process PID, and geometry via xdotool.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "x11_window_properties",
        "description": "Get X11 window properties (WM_CLASS, WM_NAME) via xprop.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "window_id": {"type": "string", "description": "Target window ID, or omit for root window"}
            }
        }
    },
    {
        "name": "x11_list_input_devices",
        "description": "List all physical and virtual input devices recognized by X11 via xinput.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "x11_keyboard_state",
        "description": "Query keyboard state (Caps Lock, Num Lock, autorepeat rates) via xset.",
        "inputSchema": {"type": "object", "properties": {}}
    }
]

def read_message():
    line = sys.stdin.readline()
    if not line:
        return None
    return json.loads(line)

def write_message(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()

def main():
    while True:
        req = read_message()
        if req is None:
            break
        req_id = req.get("id")
        method = req.get("method")
        
        if method == "initialize":
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "x11-mcp", "version": "1.0.0"}
                }
            })
        elif method == "notifications/initialized":
            pass
        elif method == "tools/list":
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {"tools": TOOLS}
            })
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            
            res = {}
            if name == "x11_session_info":
                res = x11_session_info()
            elif name == "x11_list_outputs":
                res = x11_list_outputs()
            elif name == "x11_display_info":
                res = x11_display_info()
            elif name == "x11_active_window":
                res = x11_active_window()
            elif name == "x11_window_properties":
                res = x11_window_properties(args.get("window_id"))
            elif name == "x11_list_input_devices":
                res = x11_list_input_devices()
            elif name == "x11_keyboard_state":
                res = x11_keyboard_state()
            else:
                res = {"error": f"Unknown tool: {name}"}
                
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(res, indent=2)}]
                }
            })
        else:
            if req_id is not None:
                write_message({
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "error": {"code": -32601, "message": f"Method {method} not found"}
                })

if __name__ == "__main__":
    main()
