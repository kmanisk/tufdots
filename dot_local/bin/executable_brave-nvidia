#!/usr/bin/env bash
# Brave Browser Launcher (discrete NVIDIA RTX 5050 testing via Vulkan PRIME offload)
BRAVE_BIN=$(command -v /usr/bin/brave-origin || command -v /usr/sbin/brave-origin || command -v /usr/bin/brave)
if [ -z "$BRAVE_BIN" ]; then
    echo "brave-nvidia launcher: real binary not found" >&2
    exit 1
fi

exec prime-run "$BRAVE_BIN" \
    --force-device-scale-factor=1.40 \
    --enable-features=Vulkan \
    --use-angle=vulkan \
    "$@"
