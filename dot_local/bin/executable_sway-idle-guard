#!/usr/bin/env bash
# sway-idle-guard: pause swayidle while a fullscreen window is focused.
# Prevents auto-lock / black screen during fullscreen gaming (controller
# play generates no keyboard/mouse input, so idle timers would fire).
# Event-driven via sway subscribe — no polling. Singleton via flock.
set -u
LOCK="/tmp/sway-idle-guard.lock"
exec 9>"$LOCK"
flock -n 9 || exit 0

set_state() { # $1 = paused|active
    if [ "$1" = "paused" ]; then
        pkill -STOP -x swayidle 2>/dev/null
    else
        pkill -CONT -x swayidle 2>/dev/null
    fi
}

apply_current() {
    if swaymsg -t get_tree 2>/dev/null | python3 -c '
import json, sys
try:
    tree = json.load(sys.stdin)
except Exception:
    sys.exit(1)

def check_game_active(node, current_ws=None):
    if node.get("type") == "workspace":
        current_ws = node.get("name")
        # If workspace 4 has any windows and is focused/visible, inhibit idle
        if current_ws == "4" and (node.get("nodes") or node.get("floating_nodes")):
            return True

    # Check focused container
    if node.get("focused"):
        if node.get("fullscreen_mode"):
            return True
        if current_ws == "4":
            return True
        c = str(node.get("app_id") or node.get("window_properties", {}).get("class") or "").lower()
        t = str(node.get("name") or "").lower()
        if any(k in c for k in ["steam_app_", "gamescope", "cs2", "eldenring", "gtaiv", "launcher.exe", "socialclubhelper.exe", "playgtaiv"]):
            return True
        if any(k in t for k in ["grand theft auto", "gtaiv", "rockstar games", "elden ring"]):
            return True

    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        if check_game_active(child, current_ws):
            return True
    return False

sys.exit(0 if check_game_active(tree) else 1)
'; then
        set_state paused
    else
        set_state active
    fi
}

apply_current  # initial state (e.g. login straight into a game)
stdbuf -o0 swaymsg -t subscribe -m '["window"]' 2>/dev/null | while read -r ev; do
    echo "$ev" | grep -qE '"change":[[:space:]]*"focus"|"change":[[:space:]]*"fullscreen_mode"' || continue
    apply_current
done
