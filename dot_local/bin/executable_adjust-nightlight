#!/usr/bin/env bash
# ==============================================================================
# Adjust Night Light Color Temperature Up/Down (Flicker-Free)
# Range: 2000K (Warm Amber) - 6500K (Daylight Neutral)
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"

DELTA="${1:-100}"
STATE_FILE="$HOME/.config/nightlight_state"
TEMP_FILE="$HOME/.config/nightlight_temp"

CURRENT_TEMP=4200
if [[ -f "$TEMP_FILE" ]]; then
    CURRENT_TEMP=$(cat "$TEMP_FILE" 2>/dev/null)
fi

NEW_TEMP=$(( CURRENT_TEMP + DELTA ))

# Clamp between 2000K and 6500K
if (( NEW_TEMP > 6500 )); then
    NEW_TEMP=6500
fi
if (( NEW_TEMP < 2000 )); then
    NEW_TEMP=2000
fi

echo "$NEW_TEMP" > "$TEMP_FILE"

# Calculate percentage (2000K = 0%, 6500K = 100%)
PERCENT=$(( (NEW_TEMP - 2000) * 100 / 4500 ))

if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$SWAYSOCK" ]; then
    # Kill stale gammastep if present
    pkill -9 -x gammastep >/dev/null 2>&1 || true

    # Flicker-free dynamic Wayland adjustment via wlsunset
    if pgrep -x wlsunset >/dev/null 2>&1; then
        pkill -USR2 -x wlsunset
    elif [ -n "$SWAYSOCK" ] && command -v swaymsg >/dev/null 2>&1; then
        swaymsg exec "/home/manisk/.local/bin/wlsunset -m $NEW_TEMP" >/dev/null 2>&1
    else
        setsid -f /home/manisk/.local/bin/wlsunset -m "$NEW_TEMP" </dev/null >/dev/null 2>&1
    fi
else
    # X11 atomic update
    redshift -r -P -m randr -O "$NEW_TEMP" >/dev/null 2>&1
fi

if (( NEW_TEMP >= 6500 )); then
    echo "off" > "$STATE_FILE"
    MSG="Night Light: 6500K (Daylight)"
else
    echo "on" > "$STATE_FILE"
    MSG="Night Light: ${NEW_TEMP}K"
fi

# Send synchronized OSD notification (supported by Mako and Dunst)
notify-send -a "Night Light" -u low -i preferences-desktop-display \
    -h string:x-canonical-private-synchronous:nightlight \
    -h string:x-dunst-stack-tag:nightlight \
    -h int:value:"$PERCENT" \
    "$MSG"
