#!/usr/bin/env bash
# ==============================================================================
# Waybar Launcher - Enforces persistent bar_state across reboots / reloads
# ==============================================================================
STATE_FILE="$HOME/.config/polybar/bar_state"
state=$(cat "$STATE_FILE" 2>/dev/null || echo "false")

case "$state" in
    false|hidden|0|off)
        # Bar is disabled / hidden: terminate cleanly and do not spawn
        pkill -x waybar 2>/dev/null || true
        exit 0
        ;;
    *)
        # Bar is visible: spawn if not already running
        if ! pgrep -x waybar >/dev/null 2>&1; then
            waybar >/dev/null 2>&1 &
        fi
        ;;
esac
