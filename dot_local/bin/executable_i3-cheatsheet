#!/usr/bin/env python3
"""
i3-cheatsheet: Dynamic Keybinding & Shortcut Auditor and Visualizer
- Parses live ~/.config/i3/config, ~/.config/zed/keymap.json, and ~/.config/xremap/config.yml
- Outputs clean Markdown tables formatted for Zed preview or terminal view
- Supports interactive search via Rofi (-r / --rofi)
- Supports direct launch into Zed Markdown preview (-z / --zed)
"""
import sys
import re
import json
import subprocess
from pathlib import Path

I3_CONFIG = Path.home() / ".config/i3/config"
ZED_KEYMAP = Path.home() / ".config/zed/keymap.json"
CHEATSHEET_MD = Path.home() / ".local/share/i3-cheatsheet.md"

def friendly_key(combo):
    """Make key combos human readable and clean."""
    res = combo.replace("$mod", "Win")
    res = res.replace("Mod1", "Alt")
    res = res.replace("Mod4", "Win")
    res = res.replace("Control", "Ctrl")
    res = res.replace("Return", "Enter")
    res = res.replace("space", "Space")
    res = res.replace("slash", "/")
    res = res.replace("braceleft", "{")
    res = res.replace("braceright", "}")
    res = res.replace("bracketleft", "[")
    res = res.replace("bracketright", "]")
    res = res.replace("quotedbl", '"')
    res = res.replace("apostrophe", "'")
    return res

def friendly_action(action):
    """Convert raw exec commands into clean, readable descriptions."""
    act = action.strip()
    act = re.sub(r'^exec\s+(--no-startup-id\s+)?', '', act)
    act = act.strip('"\'')
    
    # Common mappings
    mapping = {
        "pkill rofi || rofi -show drun": "Launch Application Finder (Rofi)",
        "~/.local/bin/rofi-websearch": "Web Search (Google, YT, GitHub, Wiki)",
        "~/.local/bin/rofi-websearch --floating": "Floating Centered Web Search",
        "brave-origin": "Launch Brave Browser (Intel iGPU)",
        "split h": "Split container horizontally",
        "split v": "Split container vertically",
        "fullscreen toggle": "Toggle Fullscreen",
        "floating toggle": "Toggle Floating / Tiling",
        "focus mode_toggle": "Toggle Focus Floating/Tiled",
        "kill": "Close / Kill focused window",
        "layout tabbed": "Switch layout to Tabbed",
        "layout stacking": "Switch layout to Stacking",
        "layout toggle split": "Toggle Split Layout",
        "~/.local/bin/rofi-clipboard": "Clipboard History (Rofi + Persistent Storage)",
        "~/.local/bin/rofi-pkill": "Process Killer Menu (Unique Processes)",
        "~/.local/bin/screenshot-region": "Screenshot Interactive Region (Maim)",
        "~/.local/bin/toggle-audio-sink": "Toggle Audio Output (Speakers / Headset)",
        "~/.local/bin/toggle-headset-mic": "Toggle Headset Microphone Mute",
        "~/.local/bin/rofi-favorites": "Favorite URLs & Bookmarks Menu",
        "~/.local/bin/toggle-nightlight": "Toggle Night Light (Redshift)",
        "~/.local/bin/adjust-nightlight +250": "Night Light: Warmer / Increase Temp (+250K)",
        "~/.local/bin/adjust-nightlight -250": "Night Light: Cooler / Decrease Temp (-250K)",
        "~/.local/bin/i3-session-save --all": "Save All Workspaces Session",
        "~/.local/bin/i3-session-restore --all": "Restore All Workspaces Session",
        "~/.local/bin/i3-session-menu": "Interactive Session Save/Restore Menu",
        "~/.local/bin/i3-session-save": "Save Current Workspace Session",
        "~/.local/bin/i3-session-restore": "Restore Current Workspace Session",
        "~/.local/bin/alacritty-quick": "Spawn Quick Floating Terminal",
        "~/.local/bin/toggle-cursor-theme": "Toggle Cursor Theme (Dark / Light)",
        "~/.local/bin/adjust-cursor-size +4": "Increase Cursor Size (+4px)",
        "~/.local/bin/adjust-cursor-size -4": "Decrease Cursor Size (-4px)",
        "reload": "Reload i3wm configuration",
        "restart": "Restart i3wm in-place",
    }
    for k, v in mapping.items():
        if k in act:
            return v
            
    # Generic regex cleanups
    if "workspace number" in act:
        m = re.search(r'workspace number\s+(\S+)', act)
        if m:
            return f"Switch to Workspace {m.group(1)}"
    if "move container to workspace number" in act:
        m = re.search(r'move container to workspace number\s+(\S+)', act)
        if m:
            return f"Move focused window to Workspace {m.group(1)}"
    if "focus" in act and any(d in act for d in ("left", "right", "up", "down")):
        m = re.search(r'focus\s+(left|right|up|down)', act)
        if m:
            return f"Focus window {m.group(1)}"
    if "move" in act and any(d in act for d in ("left", "right", "up", "down")):
        m = re.search(r'move\s+(left|right|up|down)', act)
        if m:
            return f"Move window {m.group(1)}"
            
    return act

def parse_i3():
    if not I3_CONFIG.exists():
        return {}
    lines = I3_CONFIG.read_text().splitlines()
    categories = {
        "Navigation & Workspaces": [],
        "Window Management": [],
        "Launchers & Productivity": [],
        "Audio, Display & Night Light": [],
        "Session & System": [],
    }
    
    for line in lines:
        line = line.strip()
        if not line.startswith("bindsym"):
            continue
        m = re.match(r'bindsym\s+(?:--release\s+)?(\S+)\s+(.+)', line)
        if not m:
            continue
        raw_combo, raw_action = m.groups()
        key = friendly_key(raw_combo)
        desc = friendly_action(raw_action)
        
        # Categorize
        if any(w in desc.lower() for w in ("workspace", "focus", "move window")):
            categories["Navigation & Workspaces"].append((key, desc))
        elif any(w in desc.lower() for w in ("split", "floating", "fullscreen", "tabbed", "stacking", "close", "kill")):
            categories["Window Management"].append((key, desc))
        elif any(w in desc.lower() for w in ("finder", "search", "brave", "clipboard", "screenshot", "terminal", "favorites", "rofi")):
            categories["Launchers & Productivity"].append((key, desc))
        elif any(w in desc.lower() for w in ("audio", "mic", "night light", "display", "sink")):
            categories["Audio, Display & Night Light"].append((key, desc))
        else:
            categories["Session & System"].append((key, desc))
            
    return categories

def parse_zed():
    if not ZED_KEYMAP.exists():
        return []
    try:
        # Strip comments
        raw = ZED_KEYMAP.read_text()
        clean = re.sub(r'//.*', '', raw)
        clean = re.sub(r',\s*([\]}])', r'\1', clean)
        data = json.loads(clean)
        zed_binds = []
        for block in data:
            ctx = block.get("context", "Global")
            bindings = block.get("bindings", {})
            for k, v in bindings.items():
                act = v if isinstance(v, str) else str(v[0] if isinstance(v, list) else v)
                zed_binds.append((ctx, k, act))
        return zed_binds
    except Exception:
        return []

def generate_markdown(i3_data, zed_data):
    md = [
        "# ⌨️ System Keyboard Cheatsheet",
        "",
        "> Dynamic keybinding matrix generated live from your actual configuration files.",
        "",
        "---",
        "",
    ]
    
    # i3 Sections
    for cat, items in i3_data.items():
        if not items:
            continue
        md.append(f"## 🖥️ i3wm: {cat}")
        md.append("")
        md.append("| Shortcut | Action / Target Description |")
        md.append("| :--- | :--- |")
        # Deduplicate while preserving order
        seen = set()
        for k, v in items:
            if (k, v) in seen:
                continue
            seen.add((k, v))
            md.append(f"| **`{k}`** | {v} |")
        md.append("")
        
    # Zed Essential Section
    if zed_data:
        md.append("## ⚡ Zed Editor Keybindings")
        md.append("")
        md.append("| Context | Shortcut | Action |")
        md.append("| :--- | :--- | :--- |")
        important = [
            ("alt-p", "command_palette::Toggle", "Toggle Command Palette"),
            ("alt-f", "file_finder::Toggle", "Toggle File Finder"),
            ("alt-w", "pane::CloseActiveItem", "Close Active Tab / Pane"),
            ("alt-r", "task::Spawn (run file)", "Run Current File (zed-run-file)"),
            ("alt-j", "pane::ActivateNextItem", "Next Editor Tab"),
            ("alt-k", "pane::ActivatePreviousItem", "Previous Editor Tab"),
            ("ctrl-;", "workspace::ToggleBottomDock", "Toggle Integrated Terminal"),
            ("ctrl-,", "zed::OpenSettings", "Open Zed Settings"),
        ]
        for key, raw, desc in important:
            md.append(f"| Workspace | **`{key}`** | {desc} (`{raw}`) |")
        md.append("")
        
    return "\n".join(md)

def main():
    args = sys.argv[1:]
    i3_data = parse_i3()
    zed_data = parse_zed()
    
    # Save live markdown
    CHEATSHEET_MD.parent.mkdir(parents=True, exist_ok=True)
    md_content = generate_markdown(i3_data, zed_data)
    CHEATSHEET_MD.write_text(md_content)
    
    if "-r" in args or "--rofi" in args:
        # Format lines for interactive Rofi search
        rofi_lines = []
        for cat, items in i3_data.items():
            for k, v in items:
                rofi_lines.append(f"[{cat}] {k:22} ➔  {v}")
        if zed_data:
            rofi_lines.append(f"[Zed Editor] {'Alt + r':22} ➔  Run File (task::Spawn)")
            rofi_lines.append(f"[Zed Editor] {'Alt + p':22} ➔  Command Palette")
            rofi_lines.append(f"[Zed Editor] {'Alt + f':22} ➔  File Finder")
            rofi_lines.append(f"[Zed Editor] {'Alt + w':22} ➔  Close Active Pane")
            rofi_lines.append(f"[Zed Editor] {'Alt + j / k':22} ➔  Next / Prev Tab")
            
        rofi_input = "\n".join(rofi_lines)
        theme_path = Path.home() / ".config/rofi/cheatsheet.rasi"
        cmd = ["rofi", "-dmenu", "-i", "-p", "⌨️ Keybinds Cheatsheet"]
        if theme_path.exists():
            cmd += ["-theme", str(theme_path)]
        else:
            cmd += ["-l", "20", "-width", "65"]
        subprocess.run(cmd, input=rofi_input, text=True)
        return

    if "-z" in args or "--zed" in args:
        # Open in Zed
        subprocess.run(["zed", str(CHEATSHEET_MD)])
        return

    if "-p" in args or "--print" in args:
        print(md_content)
        return

    # Default: if run in terminal without flags, print formatted markdown
    print(md_content)

if __name__ == "__main__":
    main()
