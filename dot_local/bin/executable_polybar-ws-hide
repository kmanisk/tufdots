#!/usr/bin/env python3
"""
polybar-ws-hide: keep the system bar off the games workspace.
Listens to i3 workspace::focus events and re-runs bar-apply (no --force),
which hides the bar on ws4 and restores it elsewhere per bar_state.
Singleton: started via exec_always with a pkill guard in the i3 config.
"""
import json
import os
import signal
import socket
import struct
import subprocess
import time

BAR_APPLY = os.path.expanduser("~/.local/bin/bar-apply")


def get_socketpath():
    env = os.environ.get("I3SOCK")
    if env and os.path.exists(env):
        return env
    try:
        out = subprocess.check_output(["i3", "--get-socketpath"], timeout=2).decode().strip()
        if os.path.exists(out):
            return out
    except Exception:
        pass
    return None


def send(sock, msg_type, payload=""):
    data = payload.encode()
    sock.sendall(struct.pack("=6sII", b"i3-ipc", len(data), msg_type))


def recv(sock):
    header = sock.recv(14)
    if not header or len(header) < 14:
        return None, None
    _, length, _ = struct.unpack("=6sII", header)
    payload = b""
    while len(payload) < length:
        chunk = sock.recv(length - len(payload))
        if not chunk:
            break
        payload += chunk
    try:
        return None, json.loads(payload.decode())
    except Exception:
        return None, None


running = True


def stop(signum, frame):
    global running
    running = False


signal.signal(signal.SIGINT, stop)
signal.signal(signal.SIGTERM, stop)


def main():
    while running:
        path = get_socketpath()
        if not path:
            time.sleep(2)
            continue
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(path)
            send(s, 2, '["workspace"]')
            recv(s)
            while running:
                _, event = recv(s)
                if event is None:
                    break
                if isinstance(event, dict) and event.get("change") == "focus":
                    subprocess.run([BAR_APPLY],
                                   stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL,
                                   timeout=15)
        except Exception:
            pass
        finally:
            try:
                s.close()
            except Exception:
                pass
        time.sleep(1)


if __name__ == "__main__":
    main()
