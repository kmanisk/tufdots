#!/usr/bin/env bash
# ==============================================================================
# cliphist-daemon: Event-Driven Persistent X11 Clipboard Daemon
# Uses clipnotify (XFixes event streaming) to store clips into BoltDB database
# Zero CPU polling at idle (~4.5MB total RAM). Survives reboots & app restarts.
#
# Retention Limits:
# - Max items in active database: 500 clips (auto FIFO eviction by cliphist)
# - Hourly auto-prune of orphaned files & old temporary pins
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.local/bin:$PATH"

DB_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/cliphist/db"
PIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/clipboard_pins"
mkdir -p "$(dirname "$DB_PATH")" "$PIN_DIR"

# Periodic maintenance counter (prunes every ~100 clip operations)
COUNTER=0

# Stream X11 selection changes via XFixes events
while clipnotify; do
    # Read clipboard content and store into BoltDB database bounded strictly to 500 items
    xsel -b -o 2>/dev/null | cliphist -db-path "$DB_PATH" -max-items 500 store 2>/dev/null
    
    COUNTER=$(( COUNTER + 1 ))
    if [ "$COUNTER" -ge 100 ]; then
        COUNTER=0
        # Delete unpinned history items beyond the 500 limit
        cliphist -db-path "$DB_PATH" list 2>/dev/null | tail -n +501 | while read -r old_item; do
            cliphist -db-path "$DB_PATH" delete <<< "$old_item" 2>/dev/null
        done
        # Prune pins older than 30 days
        find "$PIN_DIR" -type f -mtime +30 -delete 2>/dev/null
    fi
done
