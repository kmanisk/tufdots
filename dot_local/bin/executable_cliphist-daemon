#!/usr/bin/env bash
# ==============================================================================
# cliphist-daemon: clipboard watcher (Wayland-native + XWayland fallback)
# Single store: cliphist default DB (shared with fuzzel-clipboard/rofi-clipboard)
# Managed by: cliphist.service (user unit, enabled)
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"
export DISPLAY="${DISPLAY:-:0}"

# --- Wayland watcher: catches native app copies (Brave, Firefox, etc.) ---
wl-paste --watch cliphist store 2>/dev/null &
WL_PID=$!

# --- X11 watcher: catches XWayland app copies ---
(
while clipnotify 2>/dev/null || sleep 5; do
    clip=$(xsel -b -o 2>/dev/null)
    [ -n "$clip" ] && printf '%s' "$clip" | cliphist store 2>/dev/null
done
) &
X11_PID=$!

# --- Hourly prune (500 items + 30-day pins) ---
(
while sleep 3600; do
    "$HOME/.local/bin/cliphist-prune" 2>/dev/null
done
) &

wait $WL_PID $X11_PID
