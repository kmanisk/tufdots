#!/usr/bin/env python3
"""
i3-session-restore: Robust, race-free i3 session restore with duplicate prevention.
- Sequential layout & program dispatch per workspace (no cross-workspace contamination).
- Deduplicates instances (never spawns duplicate terminals, browsers, or Zed editors).
- Normalizes application commands (cleans stale sockets and ephemeral paths).
- Respects Steam lifecycle (never restores Steam if killed before/at shutdown).
- Silent on startup (no intrusive desktop notification).
- Active placeholder monitoring & automatic pruning of dead swallow boxes.
- Always lands focused on Workspace 2 (browser default).
"""
import os
import sys
import json
import time
import shutil
import subprocess
from pathlib import Path

SAVE_DIR = Path.home() / ".i3" / "i3-resurrect"
STEAM_KILLED_FLAG = SAVE_DIR / "steam_was_killed"
STEAM_KILLED_TMP = Path("/tmp/steam_killed_by_user")

def get_tree():
    try:
        return json.loads(subprocess.check_output(["i3-msg", "-t", "get_tree"], stderr=subprocess.DEVNULL))
    except Exception:
        return {}

def get_workspace_windows(tree):
    """Returns a dict mapping workspace_name -> list of window dicts."""
    ws_map = {}
    def walk(node, cur_ws=None):
        if node.get("type") == "workspace":
            cur_ws = str(node.get("num") or node.get("name"))
            if cur_ws not in ws_map:
                ws_map[cur_ws] = []
        if node.get("window") and cur_ws:
            props = node.get("window_properties", {})
            ws_map[cur_ws].append({
                "id": node.get("id"),
                "window": node.get("window"),
                "class": props.get("class", "").lower(),
                "instance": props.get("instance", "").lower(),
                "title": props.get("title", "").lower(),
            })
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            walk(child, cur_ws)
    walk(tree)
    return ws_map

def is_steam_running():
    try:
        subprocess.check_output(["pgrep", "-x", "steam"], stderr=subprocess.DEVNULL)
        return True
    except Exception:
        return False

def was_steam_killed():
    if STEAM_KILLED_TMP.exists() or STEAM_KILLED_FLAG.exists():
        return True
    return False

def is_unfilled_placeholder(node):
    """Accurately identifies an i3 placeholder container that has not swallowed a window."""
    swallows = node.get("swallows")
    if not swallows or not isinstance(swallows, list) or len(swallows) == 0:
        return False
    # Never kill docks / polybar
    if any("dock" in str(s).lower() for s in swallows):
        return False
    # In i3wm, a real swallowed window has window_properties with class/instance.
    # An unfilled placeholder has no 'class' property in window_properties.
    wp = node.get("window_properties")
    if wp and wp.get("class"):
        return False
    return True

def clean_unfilled_placeholders(workspace_name=None):
    """Kill any placeholder containers that failed to swallow a window."""
    tree = get_tree()
    killed = 0
    def walk(node, cur_ws=None):
        nonlocal killed
        if node.get("type") == "workspace":
            cur_ws = str(node.get("num") or node.get("name"))
        if is_unfilled_placeholder(node):
            if workspace_name is None or str(cur_ws) == str(workspace_name):
                con_id = node.get("id")
                try:
                    subprocess.call(["i3-msg", f'[con_id="{con_id}"] kill'],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    killed += 1
                except Exception:
                    pass
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            walk(child, cur_ws)
    walk(tree)
    return killed

def spawn_background_placeholder_watcher(target_workspaces=None, timeout=6.0):
    """Spawn a detached background monitor to ensure all placeholders swallow or get pruned."""
    try:
        pid = os.fork()
        if pid > 0:
            return
        os.setsid()
    except Exception:
        return

    start = time.time()
    while time.time() - start < timeout:
        time.sleep(0.4)
        tree = get_tree()
        unfilled = []
        def walk(node, cur_ws=None):
            if node.get("type") == "workspace":
                cur_ws = str(node.get("num") or node.get("name"))
            if is_unfilled_placeholder(node):
                if target_workspaces is None or str(cur_ws) in target_workspaces:
                    unfilled.append(node.get("id"))
            for child in node.get("nodes", []) + node.get("floating_nodes", []):
                walk(child, cur_ws)
        walk(tree)
        if not unfilled:
            # All placeholders successfully swallowed
            sys.exit(0)

    # Timeout reached (6 seconds): prune any dead unfilled placeholders so ghost boxes vanish
    for cid in unfilled:
        try:
            subprocess.call(["i3-msg", f'[con_id="{cid}"] kill'],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
    sys.exit(0)

def is_workspace_already_populated(ws_num, ws_windows):
    """Check if programs saved for this workspace are already open on it."""
    prog_file = SAVE_DIR / f"workspace_{ws_num}_programs.json"
    if not prog_file.exists():
        return False

    try:
        with open(prog_file) as f:
            saved_progs = json.load(f)
    except Exception:
        return False

    if not saved_progs:
        return False

    current_wins = ws_windows.get(str(ws_num), [])
    if not current_wins:
        return False

    cmd_to_class = {
        "alacritty": "alacritty",
        "ghostty": "ghostty",
        "brave": "brave-origin",
        "brave-origin": "brave-origin",
        "firefox": "firefox",
        "steam": "steam",
        "zed": "zed",
        "zed-editor": "zed",
    }

    for prog in saved_progs:
        cmd = prog.get("command", [])
        if isinstance(cmd, list) and cmd:
            base_cmd = Path(cmd[0]).name.lower()
        elif isinstance(cmd, str):
            base_cmd = Path(cmd.split()[0]).name.lower()
        else:
            continue

        # If Steam was killed, don't count Steam as an expected program
        if "steam" in base_cmd and was_steam_killed():
            continue

        expected_class = cmd_to_class.get(base_cmd, base_cmd)
        found = any(expected_class in w["class"] or expected_class in w["instance"] for w in current_wins)
        if not found:
            return False

    return True

def restore_single_workspace(ws_num, ws_windows):
    """Restore layout and programs for a single workspace in clean sequence."""
    layout_file = SAVE_DIR / f"workspace_{ws_num}_layout.json"
    prog_file = SAVE_DIR / f"workspace_{ws_num}_programs.json"

    # 1. Switch to the target workspace first
    subprocess.call(["i3-msg", f"workspace number {ws_num}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 2. Append layout if present
    if layout_file.exists():
        subprocess.call(["i3-resurrect", "restore", "-w", str(ws_num), "--layout-only"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 3. Launch saved programs
    if not prog_file.exists():
        return

    try:
        with open(prog_file) as f:
            saved_progs = json.load(f)
    except Exception:
        return

    current_wins = ws_windows.get(str(ws_num), [])

    for entry in saved_progs:
        cmd = entry.get("command", [])
        working_dir = entry.get("working_directory", str(Path.home()))
        if not Path(working_dir).exists():
            working_dir = str(Path.home())

        if isinstance(cmd, list):
            cmd_args = [str(arg) for arg in cmd if arg != "" and not ("/tmp/" in arg and "socket" in arg)]
            base_cmd = Path(cmd_args[0]).name.lower() if cmd_args else ""
        else:
            cmd_args = str(cmd).split()
            base_cmd = Path(cmd_args[0]).name.lower() if cmd_args else ""

        # Normalize Zed to 'zed'
        if "zed" in base_cmd:
            cmd_args = ["zed"]
            base_cmd = "zed"

        # Normalize Brave to 'brave-origin'
        if "brave" in base_cmd:
            cmd_args = ["brave-origin"]
            base_cmd = "brave-origin"

        # Normalize Alacritty
        if "alacritty" in base_cmd:
            cmd_args = ["alacritty"]
            base_cmd = "alacritty"

        # Steam safety: if Steam was killed or is not supposed to restore, skip!
        if "steam" in base_cmd:
            if was_steam_killed():
                continue
            if is_steam_running():
                continue

        # Duplicate terminal prevention
        if "alacritty" in base_cmd:
            has_term = any("alacritty" in w["class"] for w in current_wins)
            if has_term:
                continue

        # Duplicate browser prevention
        if base_cmd in ("brave", "brave-origin", "firefox", "librewolf"):
            has_browser = any(b in w["class"] for w in current_wins for b in ("brave", "firefox", "librewolf"))
            if has_browser:
                continue

        # Duplicate Zed prevention
        if "zed" in base_cmd:
            has_zed = any("zed" in w["class"] for w in current_wins)
            if has_zed:
                continue

        cmd_joined = " ".join(cmd_args)
        if working_dir and working_dir != str(Path.home()) and Path(working_dir).is_dir():
            exec_cmd = f'workspace number {ws_num}; exec --no-startup-id sh -c "cd {json.dumps(working_dir)} && exec {cmd_joined}"'
        else:
            exec_cmd = f'workspace number {ws_num}; exec --no-startup-id {cmd_joined}'

        subprocess.call(["i3-msg", exec_cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def notify(summary, body, icon="view-restore"):
    try:
        subprocess.call(["notify-send", "-i", icon, summary, body])
    except Exception:
        pass

def main():
    args = sys.argv[1:]
    show_notifications = "--notify" in args
    is_all_restore = "--all" in args

    if not SAVE_DIR.exists() and not is_all_restore:
        if show_notifications:
            notify("i3 Session", "No saved sessions found", "dialog-warning")
        sys.exit(1)

    tree = get_tree()
    ws_windows = get_workspace_windows(tree)

    post_focus = "2" if is_all_restore else None
    if "--post-focus" in args:
        try:
            idx = args.index("--post-focus")
            post_focus = str(args[idx + 1])
        except (IndexError, ValueError):
            pass

    if is_all_restore:
        layout_files = sorted(SAVE_DIR.glob("workspace_*_layout.json"))
        to_restore = []

        for f in layout_files:
            ws_num = f.stem.replace("workspace_", "").replace("_layout", "")
            if not is_workspace_already_populated(ws_num, ws_windows):
                to_restore.append(ws_num)

        # Restore workspaces sequentially to eliminate race conditions
        for ws in to_restore:
            restore_single_workspace(ws, ws_windows)

        # Fallback handling for cold/clean boot:
        # Re-fetch tree to verify populated workspaces
        tree_after = get_tree()
        ws_wins_after = get_workspace_windows(tree_after)

        # 1. Ensure ws1 has a terminal
        ws1_wins = ws_wins_after.get("1", [])
        has_ws1_term = any("alacritty" in w["class"] for w in ws1_wins)
        if not has_ws1_term and not any(ws == "1" for ws in to_restore):
            subprocess.call(["i3-msg", "workspace number 1; exec --no-startup-id alacritty"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # 2. Ensure ws2 has a browser
        ws2_wins = ws_wins_after.get("2", [])
        has_ws2_browser = any("brave" in w["class"] for w in ws2_wins)
        if not has_ws2_browser and not any(ws == "2" for ws in to_restore):
            subprocess.call(["i3-msg", "workspace number 2; exec --no-startup-id brave-origin"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # 3. Always focus target workspace (ws2 default)
        target_ws = post_focus or "2"
        subprocess.call(["i3-msg", f"workspace number {target_ws}"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # 4. Asynchronous placeholder monitoring & timeout cleanup (detached background watcher)
        # Prevents ghost placeholder boxes while giving apps time to swallow
        spawn_background_placeholder_watcher(target_workspaces=to_restore if to_restore else None, timeout=6.0)

        if show_notifications:
            notify("i3 Session", f"Restored {len(to_restore)} workspace(s)")

    else:
        # Restore focused workspace only (manual keybinding)
        focused_ws = None
        try:
            workspaces = json.loads(subprocess.check_output(["i3-msg", "-t", "get_workspaces"]))
            for ws in workspaces:
                if ws.get("focused"):
                    focused_ws = str(ws.get("num"))
                    break
        except Exception:
            pass

        if focused_ws:
            layout_file = SAVE_DIR / f"workspace_{focused_ws}_layout.json"
            if not layout_file.exists():
                notify("i3 Session", f"No saved session for workspace {focused_ws}", "dialog-warning")
            elif is_workspace_already_populated(focused_ws, ws_windows):
                notify("i3 Session", f"Workspace {focused_ws} is already populated", "dialog-information")
            else:
                restore_single_workspace(focused_ws, ws_windows)
                time.sleep(1.0)
                clean_unfilled_placeholders(focused_ws)
                notify("i3 Session", f"Restored workspace {focused_ws}")

if __name__ == "__main__":
    main()
