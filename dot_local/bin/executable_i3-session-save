#!/usr/bin/env bash
# ==============================================================================
# i3-session-save: Robust i3 session preservation (shutdown, reboot, manual)
# ==============================================================================
export PATH="$HOME/.local/bin:$PATH"
SAVE_DIR="$HOME/.i3/i3-resurrect"
mkdir -p "$SAVE_DIR"

# Check whether Steam is actively running and has an open window
is_steam_alive() {
    [ -f /tmp/steam_killed_by_user ] && return 1
    pgrep -x steam >/dev/null 2>&1 || return 1
    i3-msg -t get_tree 2>/dev/null | grep -qE '"(class|instance)": ?"steam' || return 1
    return 0
}

# Sanitize saved workspace files
sanitize_saved_workspace() {
    local ws="$1"
    local prog_file="$SAVE_DIR/workspace_${ws}_programs.json"
    local layout_file="$SAVE_DIR/workspace_${ws}_layout.json"
    local steam_status=0
    if is_steam_alive; then
        steam_status=1
    fi

    # 1. Clean scratchpad windows out if any leaked into save files
    # 2. If Steam was killed or is not running, purge Steam from saved programs and layout
    python3 -c "
import json, sys
from pathlib import Path

prog_path = Path(sys.argv[1])
layout_path = Path(sys.argv[2])
steam_alive = (sys.argv[3] == '1')

# Prune Steam and scratchpad apps from programs
if prog_path.exists():
    try:
        with open(prog_path) as f:
            progs = json.load(f)
        clean_progs = []
        for p in progs:
            cmd = p.get('command', [])
            cmd_str = ' '.join(cmd).lower() if isinstance(cmd, list) else str(cmd).lower()
            if not steam_alive and 'steam' in cmd_str:
                continue
            if 'scratch-term' in cmd_str or 'scratch-notes' in cmd_str:
                continue
            clean_progs.append(p)
        with open(prog_path, 'w') as f:
            json.dump(clean_progs, f, indent=2)
    except Exception:
        pass

# Prune dead swallow nodes from layout
if layout_path.exists() and not steam_alive:
    try:
        with open(layout_path) as f:
            layout = json.load(f)

        def prune_node(node):
            if not isinstance(node, dict):
                return node
            for k in ['nodes', 'floating_nodes']:
                if k in node and isinstance(node[k], list):
                    new_children = []
                    for c in node[k]:
                        swallows = c.get('swallows', [])
                        has_steam = any('steam' in str(s.get('class', '')).lower() or 'steam' in str(s.get('instance', '')).lower() for s in swallows)
                        if not has_steam:
                            new_children.append(prune_node(c))
                    node[k] = new_children
            return node

        pruned = prune_node(layout)
        with open(layout_path, 'w') as f:
            json.dump(pruned, f, indent=2)
    except Exception:
        pass

# If the workspace now has zero programs, delete the save files completely
if prog_path.exists():
    try:
        with open(prog_path) as f:
            p_data = json.load(f)
        if not p_data:
            prog_path.unlink(missing_ok=True)
            layout_path.unlink(missing_ok=True)
    except Exception:
        pass
" "$prog_file" "$layout_file" "$steam_status"
}

if [ "$1" = "--all" ]; then
    # Extract only active workspaces containing actual windows (excluding scratchpad)
    workspaces=$(i3-msg -t get_tree 2>/dev/null | jq -r '
      .. | objects | select(.type=="workspace" and .name!="null" and .name!="__i3_scratch") |
      select([.. | objects | select(.window!=null)] | length > 0) | .num // empty
    ' | sort -u)

    if [ -z "$workspaces" ]; then
        exit 0
    fi

    # Record whether Steam was killed
    if ! is_steam_alive; then
        touch "$SAVE_DIR/steam_was_killed"
    else
        rm -f "$SAVE_DIR/steam_was_killed"
    fi

    saved=()
    for ws in $workspaces; do
        # Skip gaming workspace (ws 4)
        [ "$ws" = "4" ] && continue
        i3-resurrect save -w "$ws" --swallow=class,instance 2>/dev/null
        sanitize_saved_workspace "$ws"
        if [ -f "$SAVE_DIR/workspace_${ws}_layout.json" ]; then
            saved+=("$ws")
        fi
    done

    # Prune stale workspace save files that are no longer active
    for f in "$SAVE_DIR"/workspace_*_layout.json; do
        [ -f "$f" ] || continue
        ws_id=$(basename "$f" | sed -E 's/workspace_([0-9]+)_layout.json/\1/')
        if [[ ! " ${saved[*]} " =~ " ${ws_id} " ]]; then
            rm -f "$SAVE_DIR/workspace_${ws_id}_layout.json" "$SAVE_DIR/workspace_${ws_id}_programs.json"
        fi
    done

    # Clean up any leftover programs files whose layout was removed
    for f in "$SAVE_DIR"/workspace_*_programs.json; do
        [ -f "$f" ] || continue
        ws_id=$(basename "$f" | sed -E 's/workspace_([0-9]+)_programs.json/\1/')
        if [ ! -f "$SAVE_DIR/workspace_${ws_id}_layout.json" ]; then
            rm -f "$f"
        fi
    done
else
    curr_ws=$(i3-msg -t get_workspaces 2>/dev/null | jq -r '.[] | select(.focused==true).num')
    if [ -n "$curr_ws" ] && [ "$curr_ws" != "4" ]; then
        i3-resurrect save -w "$curr_ws" --swallow=class,instance 2>/dev/null
        sanitize_saved_workspace "$curr_ws"
        command -v notify-send >/dev/null && notify-send -i document-save "i3 Session" "Saved workspace $curr_ws layout & programs"
    fi
fi
