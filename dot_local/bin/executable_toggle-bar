#!/usr/bin/env bash
# ==============================================================================
# Toggle Bottom Bar (Polybar) - Alt+0. The ONLY writer of bar_state besides
# initial setup. Flips the persisted state, then bar-apply enforces it.
# --force: explicit user action, so the in-game guard is bypassed.
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.local/bin:$PATH"

STATE_FILE="$HOME/.config/polybar/bar_state"
mkdir -p "$HOME/.config/polybar"

CURRENT_STATE=$(cat "$STATE_FILE" 2>/dev/null || echo "false")

case "$CURRENT_STATE" in
    false|hidden|0|off)
        echo "true" > "$STATE_FILE"
        "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
        ;;
    *)
        echo "false" > "$STATE_FILE"
        polybar-msg cmd quit 2>/dev/null || true
        pkill -x polybar 2>/dev/null || true
        rm -f /run/user/$(id -u)/polybar/ipc.*.sock 2>/dev/null
        ;;
esac
