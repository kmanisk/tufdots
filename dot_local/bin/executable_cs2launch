#!/usr/bin/env bash
# ==============================================================================
# CS2 High-Performance Native Wayland Launcher
# ASUS TUF Gaming F16 | Intel i5-13450HX | NVIDIA GeForce RTX 5050 Mobile
# Sway (Wayland) @ 1920x1200 165Hz
# ==============================================================================
#
# Verified 2026 Linux Architecture:
# - Desktop/Sway runs on Intel iGPU (Display engine: eDP-1 1920x1200@165Hz)
# - CS2 renders on dedicated NVIDIA RTX 5050 Mobile via Vulkan PRIME Offload
# - Presentation: Native Wayland (zero XWayland translation overhead)
# - CPU Pinning: Intel Raptor Lake P-Cores 0-11 (Threads 0-11, excludes E-cores 12-15)
#
# Steam Launch Option usage:
#   cs2launch %command%
# Or terminal launch:
#   cs2launch
#
# Optional environment overrides:
#   CS2_SCALE_TO_DISPLAY=1    -> Enables SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1
#   CS2_XWAYLAND=1            -> Fallback to X11/XWayland (restores Steam Overlay)
#   CS2_GAMESCOPE=1           -> Fallback to Gamescope 4:3 stretched
#   CS2_FPS_MAX=0             -> In-game FPS limit (default: 0 = uncapped)
#   CS2_FPS_MAX_UI=144        -> Menu FPS limit (default: 144)
# ==============================================================================

set -euo pipefail

# 1. GPU Offload Configuration (Documented Valve/NVIDIA Vulkan PRIME pair)
export __NV_PRIME_RENDER_OFFLOAD=1
export __VK_LAYER_NV_optimus=NVIDIA_only
export LIBVA_DRIVER_NAME=iHD

# 2. Windowing System / Driver Selection
if [ "${CS2_XWAYLAND:-0}" = "1" ]; then
    echo "==> [cs2launch] Running under X11/XWayland fallback (Steam Overlay enabled)"
    export SDL_VIDEO_DRIVER=x11
    export SDL_VIDEODRIVER=x11
else
    # Native Wayland: Direct scanout on Sway with lowest latency
    export SDL_VIDEO_DRIVER=wayland
    export SDL_VIDEODRIVER=wayland
    if [ "${CS2_SCALE_TO_DISPLAY:-0}" = "1" ]; then
        echo "==> [cs2launch] SDL Wayland scale-to-display enabled"
        export SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1
    fi
fi

# Ensure Wayland display socket is populated if running inside container/terminal
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "/run/user/$(id -u)/wayland-0" ]; then
    export WAYLAND_DISPLAY="wayland-0"
fi

# 3. CPU Core Pinning & Performance Settings
# Intel i5-13450HX topology: P-cores = CPUs 0-11 (Threads 0-11), E-cores = CPUs 12-15.
# Configurable: Set CS2_CPU_PIN="none" to disable pinning and let the kernel schedule freely.
# Set CS2_NO_GAMEMODE=1 to bypass gamemoderun.
CS2_CPU_PIN="${CS2_CPU_PIN:-0-11}"
FPS_MAX="${CS2_FPS_MAX:-0}"
FPS_MAX_UI="${CS2_FPS_MAX_UI:-144}"

# Clean, verified flags for Source 2 on Linux
CS2_FLAGS=(
    +fps_max "$FPS_MAX"
    +fps_max_ui "$FPS_MAX_UI"
)

# 4. Resolve Target Game Executable
# When invoked from Steam (%command%), $1 will be the game executable/wrapper.
# If invoked standalone from terminal, trigger through Steam or locate cs2.sh directly.
if [ $# -eq 0 ] || [[ "${1:-}" == -* ]]; then
    # Standalone terminal launch
    if pgrep -x steam >/dev/null 2>&1; then
        echo "==> [cs2launch] Steam is running. Launching Counter-Strike 2 via Steam..."
        exec steam -applaunch 730 "${CS2_FLAGS[@]}" "$@"
    else
        # Try direct location
        CS2_BIN="/mnt/Games/SteamLibrary/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh"
        if [ ! -f "$CS2_BIN" ]; then
            CS2_BIN="$HOME/.local/share/Steam/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh"
        fi
        if [ -f "$CS2_BIN" ]; then
            set -- "$CS2_BIN" "$@"
        else
            echo "ERROR: Could not locate cs2.sh and Steam is not running." >&2
            echo "Launch Counter-Strike 2 from Steam or start Steam first." >&2
            exit 1
        fi
    fi
fi

# 5. Build Execution Wrappers (Modular: taskset & gamemoderun)
CMD_PREFIX=()
if [ "$CS2_CPU_PIN" != "none" ] && [ -n "$CS2_CPU_PIN" ]; then
    CMD_PREFIX+=(taskset -c "$CS2_CPU_PIN")
fi

if [ "${CS2_NO_GAMEMODE:-0}" != "1" ] && command -v gamemoderun >/dev/null 2>&1; then
    CMD_PREFIX+=(gamemoderun)
fi

# 6. Optional Gamescope Fallback Mode (only used when explicitly requested)
if [ "${CS2_GAMESCOPE:-0}" = "1" ] && command -v gamescope >/dev/null 2>&1; then
    TARGET_W="${CS2_RES_W:-1440}"
    TARGET_H="${CS2_RES_H:-1080}"
    echo "==> [cs2launch] Launching via Gamescope (${TARGET_W}x${TARGET_H} -> 1920x1200 stretched @ 165Hz)..."
    exec "${CMD_PREFIX[@]}" gamescope \
        -w "$TARGET_W" -h "$TARGET_H" \
        -W 1920 -H 1200 \
        -r 165 -o 165 \
        -f -S stretch -F fsr \
        --force-grab-cursor \
        -- \
        "$@" "${CS2_FLAGS[@]}"
fi

# 7. Default Native Launch Chain
echo "============================================================"
echo " Counter-Strike 2 Native Wayland Launcher (2026)"
echo " Driver: ${SDL_VIDEO_DRIVER} | GPU: RTX 5050 PRIME Offload"
echo " CPU Affinity: ${CS2_CPU_PIN} | gamemoderun: ${CS2_NO_GAMEMODE:-active}"
echo "============================================================"

exec "${CMD_PREFIX[@]}" "$@" "${CS2_FLAGS[@]}"
