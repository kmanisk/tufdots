#!/usr/bin/env bash
# ==============================================================================
# CS2 Wayland Native Launcher (KDE Plasma 6 + RTX 5050 Mobile Laptop)
# ==============================================================================
# - Hardware: ASUS TUF F16 (i5-13450HX + RTX 5050 Mobile Blackwell)
# - Session: KDE Plasma 6 Wayland (KWin compositor on Intel iGPU)
# - Rendering: Direct Native Wayland Vulkan offload to NVIDIA RTX 5050
# - Scaling: SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1 handles KDE 1.2x fractional scaling
# - CPU Pinning: Physical P-cores 0-11 (Bypasses E-cores to eliminate micro-stutters)
# - Optional: Set CS2_STRETCH=1 or pass --stretch for 4:3 Gamescope stretched mode
# ==============================================================================

set -eo pipefail

# 1. Wayland & NVIDIA PRIME Offload Environment
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XDG_SESSION_TYPE=wayland
export SDL_VIDEO_DRIVER=wayland
export SDL_VIDEODRIVER=wayland
export SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
export LIBVA_DRIVER_NAME=iHD

# 2. Resolution & Stretched Configuration
TARGET_RES="${CS2_RES:-1440x1080}"
TARGET_W="${CS2_RES_W:-1440}"
TARGET_H="${CS2_RES_H:-1080}"
[ "$TARGET_RES" = "1344x1008" ] && TARGET_W=1344 && TARGET_H=1008
[ "$TARGET_RES" = "1280x960" ]  && TARGET_W=1280 && TARGET_H=960
[ "$TARGET_RES" = "1024x768" ]  && TARGET_W=1024 && TARGET_H=768

# 3. Resolve CS2 launcher executable if invoked without Steam %command% arguments
if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
    if [ -f "/mnt/Games/SteamLibrary/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh" ]; then
        set -- "/mnt/Games/SteamLibrary/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh" "$@"
    elif [ -f "$HOME/.local/share/Steam/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh" ]; then
        set -- "$HOME/.local/share/Steam/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh" "$@"
    fi
fi

CS2_FLAGS=(-vulkan -threads 7 -mainthreadpriority 2 -nojoy -novid +fps_max 0 +fps_max_ui 0)

# 4. Mode Selection: Native Wayland (Default) vs Gamescope
# Native Wayland: CS2 renders directly via SDL Wayland surface and stretches
# 4:3 fullscreen to the 1920x1200 panel with zero nested-compositor overhead.
# Set USE_GAMESCOPE=1 or CS2_GAMESCOPE=1 only if needed as fallback.
USE_GAMESCOPE="${USE_GAMESCOPE:-${CS2_GAMESCOPE:-0}}"

if [ "$USE_GAMESCOPE" = "1" ] && command -v gamescope >/dev/null 2>&1; then
    echo "==> Launching CS2 4:3 stretched (${TARGET_W}x${TARGET_H} -> 1920x1200 @ 165Hz) via Gamescope..."
    exec taskset -c 0-11 gamescope \
        -w "$TARGET_W" -h "$TARGET_H" \
        -W 1920 -H 1200 \
        -r 165 -o 165 \
        -f -S stretch -F fsr --sharpness 10 \
        --force-grab-cursor \
        -- \
        gamemoderun "$@" "${CS2_FLAGS[@]}"
else
    echo "==> Launching CS2 natively via SDL Wayland on RTX 5050 (P-cores 0-11)..."
    exec taskset -c 0-11 gamemoderun "$@" "${CS2_FLAGS[@]}"
fi
