#!/usr/bin/env python3
import sys, re
from pathlib import Path

CONFIG_FILE = Path.home() / ".config/alacritty/alacritty.toml"
if not CONFIG_FILE.exists():
    sys.exit(1)

delta = float(sys.argv[1]) if len(sys.argv) > 1 else 1.0

content = CONFIG_FILE.read_text()
match = re.search(r'(?m)^size\s*=\s*([0-9]+(?:\.[0-9]+)?)', content)
if match:
    current_size = float(match.group(1))
    new_size = round(current_size + delta, 1)
    if new_size < 8.0:
        new_size = 8.0
    elif new_size > 36.0:
        new_size = 36.0
    new_content = re.sub(r'(?m)^size\s*=\s*[0-9]+(?:\.[0-9]+)?', f'size = {new_size}', content)
    CONFIG_FILE.write_text(new_content)
