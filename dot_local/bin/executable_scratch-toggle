#!/bin/sh
# scratch-toggle <term|notes|spotify>
# Toggle a scratchpad dropdown by name. If its window doesn't exist
# (closed/crashed), spawn it first -- the i3 for_window rule auto-hides it
# into the scratchpad, then it is shown. Keys never go silently dead.
#
# First-press race fix: after spawning, wait until the window is actually
# HIDDEN in the scratchpad before issuing `show`. Showing a still-visible
# fresh window would re-hide it (launch, blink, gone).
#
# Spawn commands live here (not in the i3 bindsym line) because i3's command
# parser treats commas as command separators, which breaks
# `alacritty --class Alacritty,<instance>` when passed through a binding.
set -u

mode="${1:?usage: scratch-toggle <term|notes|spotify>}"

case "$mode" in
    term)
        instance="scratch-term"
        spawn="alacritty --class scratch-term"
        ;;
    notes)
        instance="scratch-notes"
        spawn="alacritty -o font.size=17.5 --class scratch-notes -e nvim $HOME/notes.md"
        ;;
    spotify)
        instance="spotify"
        spawn="spotify"
        ;;
    *)
        echo "unknown mode: $mode" >&2
        exit 1
        ;;
esac

IPC_CMD="i3-msg"
if [ -n "$SWAYSOCK" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    IPC_CMD="swaymsg"
fi

# Reports where the window is: missing | visible | hidden (scratchpad).
win_state() {
    $IPC_CMD -t get_tree 2>/dev/null | python3 -c '
import json, sys
inst = sys.argv[1]
try:
    tree = json.load(sys.stdin)
except Exception:
    print("missing")
    sys.exit(0)
result = ["missing"]

def walk(n, in_scratch):
    if result[0] == "hidden":
        return
    name = n.get("name") or ""
    if name in ("__i3", "__i3_scratch") or (n.get("type") == "workspace" and name == "__i3_scratch"):
        in_scratch = True
    wp = n.get("window_properties") or {}
    app_id = n.get("app_id") or ""
    cls = wp.get("class") or n.get("class") or ""
    cur_inst = wp.get("instance") or ""
    
    if cur_inst == inst or app_id == inst or cls.lower() == inst.lower():
        is_hidden = in_scratch or (n.get("scratchpad_state") not in (None, "none") and not n.get("visible", False))
        result[0] = "hidden" if is_hidden else "visible"
        return
    for c in n.get("nodes", []) + n.get("floating_nodes", []):
        walk(c, in_scratch)

walk(tree, False)
print(result[0])
' "$instance"
}

show_it() {
    if [ "$IPC_CMD" = "swaymsg" ]; then
        swaymsg "[app_id=\"$instance\"] scratchpad show" >/dev/null 2>&1 || \
        swaymsg "[class=\"(?i)$instance\"] scratchpad show" >/dev/null 2>&1 || \
        swaymsg "[instance=\"$instance\"] scratchpad show" >/dev/null 2>&1
    else
        i3-msg "[instance=\"$instance\"] scratchpad show" >/dev/null 2>&1 || \
        i3-msg "[class=\"(?i)$instance\"] scratchpad show" >/dev/null 2>&1
    fi
}

# Fast-path: if window process is already running, toggle instantly (<3ms)
if pgrep -f "$instance" >/dev/null 2>&1; then
    show_it
    exit 0
fi

# Fallback path: process missing or crashed. Spawn and poll fast (50ms intervals)
setsid sh -c "$spawn" </dev/null >/dev/null 2>&1 &
state="missing"
for _ in $(seq 1 20); do
    state="$(win_state)"
    [ "$state" = "hidden" ] && break
    sleep 0.05
done
[ "$state" = "hidden" ] && show_it
