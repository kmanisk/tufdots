#!/usr/bin/env bash
# ==============================================================================
# Firefox on discrete NVIDIA RTX 5050 (X11): full render + NVDEC decode offload
# - prime-run         : GLX/Vulkan PRIME render offload to the dGPU
# - MOZ_X11_EGL=1     : EGL backend (MANDATORY for the VA-API/NVDEC bridge)
# - LIBVA_DRIVER_NAME : force nvidia-vaapi-driver (else Intel iHD gets loaded)
# - MOZ_DISABLE_RDD_SANDBOX : RDD sandbox blocks the VA-API driver from loading
# - NVD_BACKEND=direct: EGL backend broken on drivers >= 525, direct is stable
# - CUDA_DISABLE_PERF_BOOST : driver >= 580: no forced boost while decoding
# Companion about:config (set once in the NVIDIA profile):
#   media.hardware-video-decoding.force-enabled = true
#   media.rdd-ffmpeg.enabled                    = true (default)
# Verify: play 4K VP9/AV1 -> `nvidia-smi pmon` shows DEC %, CPU drops.
# about:support -> Media table: H264/VP9/VP8 hardware-decode green.
# NOTE: default (non-nvidia) Firefox stays on the Intel iGPU for idle power.
# ==============================================================================
export MOZ_X11_EGL=1
export LIBVA_DRIVER_NAME=nvidia
export MOZ_DISABLE_RDD_SANDBOX=1
export NVD_BACKEND=direct
export CUDA_DISABLE_PERF_BOOST=1
exec prime-run /usr/bin/firefox "$@"
