#!/usr/bin/env bash
# ==============================================================================
# rofi-pkill: Interactive Process Killer Menu
# Shows UNIQUE user processes with instance count, CPU %, and Memory %
# Enter: Gracefully terminate (SIGTERM / pkill)
# Alt+d / Shift+Del: Force kill (SIGKILL / pkill -9)
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.local/bin:$PATH"

THEME="$HOME/.config/rofi/clipboard-floating.rasi"

notify() {
    command -v dunstify >/dev/null 2>&1 && dunstify -a "Process Killer" -u low -i process-stop -r 8833 "$1" "$2"
}

# Processes to protect from accidental termination
PROTECTED="^(systemd|sd-pam|dbus-broker.*|pipewire.*|wireplumber|Xorg|i3|xremap|dunst|polybar|autotiling|clipnotify|bash|fish|zsh|sh|agy|ps|grep|rofi|cat|sort|head|sed|awk|python.*)$"

list_procs() {
    python3 -c "
import subprocess, re

my_user = subprocess.check_output(['whoami']).decode().strip()
raw = subprocess.check_output(['ps', '-u', my_user, '-o', 'pid,%cpu,%mem,comm']).decode().splitlines()

protected_re = re.compile(r'$PROTECTED')

procs = {}
for line in raw[1:]:
    parts = line.strip().split(None, 3)
    if len(parts) == 4:
        pid, cpu, mem, comm = parts
        if protected_re.match(comm):
            continue
        if comm not in procs:
            procs[comm] = {'count': 0, 'cpu': 0.0, 'mem': 0.0, 'pids': []}
        procs[comm]['count'] += 1
        procs[comm]['cpu'] += float(cpu)
        procs[comm]['mem'] += float(mem)
        procs[comm]['pids'].append(pid)

# Sort by RAM % descending
for comm, d in sorted(procs.items(), key=lambda x: (x[1]['mem'], x[1]['cpu']), reverse=True):
    count_str = f'({d[\"count\"]} instances)' if d['count'] > 1 else '(1 instance) '
    print(f'{comm:<24} {count_str:<15} │ CPU: {d[\"cpu\"]:4.1f}% │ RAM: {d[\"mem\"]:4.1f}%')
" 2>/dev/null
}

while true; do
    chosen=$(list_procs | rofi -dmenu \
        -p "🛑 Kill Process" \
        -mesg "Enter: Terminate (SIGTERM)  |  Alt+d: Force Kill (SIGKILL)  |  Esc: Cancel" \
        -kb-delete-entry "" \
        -kb-custom-1 "Alt+d,Shift+Delete" \
        -theme "$THEME" \
        "$@")
    exit_code=$?

    # Esc or window cancel
    [ -z "$chosen" ] && exit 0
    [ "$exit_code" -eq 1 ] && exit 0

    # Extract clean process name (first column)
    proc_name=$(echo "$chosen" | awk '{print $1}')
    [ -z "$proc_name" ] && exit 0

    # Safety check
    if echo "$proc_name" | grep -Eq "$PROTECTED"; then
        notify "Protected Process" "$proc_name cannot be killed"
        continue
    fi

    if [ "$exit_code" -eq 10 ]; then
        # Force Kill (SIGKILL -9)
        pkill -9 -u "$USER" -x "$proc_name" 2>/dev/null
        notify "Force Killed" "SIGKILL (-9) sent to all instances of $proc_name"
    else
        # Graceful Kill (SIGTERM -15)
        pkill -u "$USER" -x "$proc_name" 2>/dev/null
        notify "Terminated" "SIGTERM sent to $proc_name"
    fi

    # Small delay for process table to refresh before re-rendering loop
    sleep 0.2
done
