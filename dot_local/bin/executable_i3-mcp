#!/usr/bin/env python3
"""
i3-mcp: Model Context Protocol server for i3 window manager inspection & control
Complies with OpenCode / Antigravity JSON-RPC 2.0 stdio MCP specification.
"""
import json
import os
import subprocess
import sys

def run_cmd(cmd, timeout=10):
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if res.returncode != 0:
            return {"error": res.stderr.strip() or f"Exit {res.returncode}"}
        return res.stdout.strip()
    except Exception as e:
        return {"error": str(e)}

def i3_version():
    raw = run_cmd(["i3", "--version"])
    return {"version": raw}

def i3_validate_config():
    res = subprocess.run(["i3", "-C"], capture_output=True, text=True, timeout=10)
    return {
        "valid": res.returncode == 0,
        "output": res.stdout.strip(),
        "error": res.stderr.strip()
    }

def i3_get_tree():
    raw = run_cmd(["i3-msg", "-t", "get_tree"])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    try:
        return json.loads(raw)
    except Exception as e:
        return {"error": f"Failed to parse i3 tree JSON: {e}"}

def i3_get_workspaces():
    raw = run_cmd(["i3-msg", "-t", "get_workspaces"])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    try:
        return json.loads(raw)
    except Exception as e:
        return {"error": f"Failed to parse workspaces JSON: {e}"}

def i3_get_outputs():
    raw = run_cmd(["i3-msg", "-t", "get_outputs"])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    try:
        return json.loads(raw)
    except Exception as e:
        return {"error": f"Failed to parse outputs JSON: {e}"}

def i3_get_marks():
    raw = run_cmd(["i3-msg", "-t", "get_marks"])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    try:
        return json.loads(raw)
    except Exception as e:
        return {"error": f"Failed to parse marks JSON: {e}"}

def i3_command(command):
    raw = run_cmd(["i3-msg", command])
    if isinstance(raw, dict) and "error" in raw:
        return raw
    try:
        return json.loads(raw)
    except:
        return {"result": raw}

def i3_reload():
    # First validate syntax with i3 -C
    val = i3_validate_config()
    if not val.get("valid"):
        return {"error": "i3 config validation failed! Refusing to reload.", "details": val}
    return i3_command("reload")

TOOLS = [
    {
        "name": "i3_version",
        "description": "Get current running i3wm version information.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "i3_validate_config",
        "description": "Validate i3 configuration syntax using 'i3 -C'. Always run before reloading.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "i3_get_tree",
        "description": "Get the complete layout tree of all workspaces, containers, and windows in i3.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "i3_get_workspaces",
        "description": "Get list of active workspaces, focused state, output assignments, and urgency status.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "i3_get_outputs",
        "description": "Get connected display outputs (e.g. eDP-1) configured in i3.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "i3_get_marks",
        "description": "Get all window marks assigned in i3.",
        "inputSchema": {"type": "object", "properties": {}}
    },
    {
        "name": "i3_command",
        "description": "Execute an i3 IPC command (e.g. 'workspace 4', 'fullscreen toggle', 'layout tabbed').",
        "inputSchema": {
            "type": "object",
            "properties": {
                "command": {"type": "string", "description": "The i3 IPC command to execute"}
            },
            "required": ["command"]
        }
    },
    {
        "name": "i3_reload",
        "description": "Safely validate and reload i3wm configuration in-place.",
        "inputSchema": {"type": "object", "properties": {}}
    }
]

def read_message():
    line = sys.stdin.readline()
    if not line:
        return None
    return json.loads(line)

def write_message(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()

def main():
    while True:
        req = read_message()
        if req is None:
            break
        req_id = req.get("id")
        method = req.get("method")
        
        if method == "initialize":
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "i3-mcp", "version": "1.0.0"}
                }
            })
        elif method == "notifications/initialized":
            pass
        elif method == "tools/list":
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {"tools": TOOLS}
            })
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            
            res = {}
            if name == "i3_version":
                res = i3_version()
            elif name == "i3_validate_config":
                res = i3_validate_config()
            elif name == "i3_get_tree":
                res = i3_get_tree()
            elif name == "i3_get_workspaces":
                res = i3_get_workspaces()
            elif name == "i3_get_outputs":
                res = i3_get_outputs()
            elif name == "i3_get_marks":
                res = i3_get_marks()
            elif name == "i3_command":
                res = i3_command(args.get("command", ""))
            elif name == "i3_reload":
                res = i3_reload()
            else:
                res = {"error": f"Unknown tool: {name}"}
                
            write_message({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(res, indent=2)}]
                }
            })
        else:
            if req_id is not None:
                write_message({
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "error": {"code": -32601, "message": f"Method {method} not found"}
                })

if __name__ == "__main__":
    main()
