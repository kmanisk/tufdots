#!/bin/sh
# boot-workspaces - settle the boot layout AFTER session-restore finishes.
#   - ws1: open Alacritty only if restore didn't already put a terminal there
#          (prevents two terminals stacking in ws1 after reboot).
#   - ws2 (browser): open Brave only if no browser is there yet.
#   - End focused on ws2: the browser workspace is the boot default.
# Runs once at i3 startup (plain `exec`), never on `restart`.
set -u

sleep 5

TREE="$(i3-msg -t get_tree 2>/dev/null)" || exit 0

has_class_on_ws() {
    # $1 = workspace num, $2 = comma-separated class list (lowercase compare)
    ws="$1"
    classes="$2"
    printf '%s' "$TREE" | python3 -c "
import json, sys
tree = json.load(sys.stdin)
wsnum = int(sys.argv[1])
wanted = set(sys.argv[2].split(','))
found = False

def walk(n):
    global found
    if found:
        return
    if n.get('type') == 'workspace' and n.get('num') == wsnum:
        stack = [n]
        while stack:
            m = stack.pop()
            wp = m.get('window_properties') or {}
            if (wp.get('class') or '').lower() in wanted:
                found = True
                return
            stack.extend(m.get('nodes', []) + m.get('floating_nodes', []))
        return
    for c in n.get('nodes', []) + n.get('floating_nodes', []):
        walk(c)

walk(tree)
sys.exit(0 if found else 1)
" "$ws" "$classes" >/dev/null 2>&1
}

# 1. Terminal on ws1 if restore left it empty
if ! has_class_on_ws 1 "alacritty"; then
    i3-msg "workspace number 1; exec alacritty" >/dev/null 2>&1
fi

# 2. Browser workspace is the boot default
i3-msg "workspace number 2" >/dev/null 2>&1

# 3. Browser on ws2 if restore left it empty
if ! has_class_on_ws 2 "brave,brave-browser,brave-origin,firefox,librewolf,zen-alpha"; then
    i3-msg "exec brave-origin" >/dev/null 2>&1
fi

# 4. ws2 tabbed default lives in the i3 config (for_window rule);
#    nothing to do here besides landing focused below.

# 5. ws3 is the default workspace: end boot focused there.
i3-msg "workspace number 3" >/dev/null 2>&1
