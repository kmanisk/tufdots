#!/usr/bin/env bash
set -eo pipefail
# Decrypt GitHub token dynamically on-demand from chezmoi encrypted store
SECRET_FILE="$HOME/.local/share/chezmoi/readonly_Documents/encrypted_new 1.txt.age"
if [ ! -f "$SECRET_FILE" ]; then
  echo "Error: Encrypted secret file not found: $SECRET_FILE" >&2
  exit 1
fi
TOKEN=$(chezmoi decrypt "$SECRET_FILE" 2>/dev/null | grep -o 'ghp_[a-zA-Z0-9]*' | head -n 1)
if [ -z "$TOKEN" ]; then
  echo "Error: Failed to decrypt GitHub token from chezmoi store" >&2
  exit 1
fi
export GITHUB_PERSONAL_ACCESS_TOKEN="$TOKEN"
exec npx -y @modelcontextprotocol/server-github
