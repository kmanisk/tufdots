#!/bin/sh
# ==============================================================================
# volume-notify: Fast volume adjustment with native Dunst OSD notification
# ==============================================================================
case "${1:-status}" in
    up)
        pamixer -ui 3
        ;;
    down)
        pamixer -ud 3
        ;;
    mute)
        pamixer -t
        ;;
esac

VOL=$(pamixer --get-volume 2>/dev/null || echo "0")
MUTE=$(pamixer --get-mute 2>/dev/null || echo "false")

if [ "$MUTE" = "true" ]; then
    dunstify -a "Volume" -u low -i audio-volume-muted -h string:x-dunst-stack-tag:volume "Volume: Muted"
else
    dunstify -a "Volume" -u low -i audio-volume-high -h string:x-dunst-stack-tag:volume -h int:value:"$VOL" "Volume: ${VOL}%"
fi
