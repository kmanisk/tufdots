#!/usr/bin/env bash
# ==============================================================================
# Night Light Toggle for i3wm (using Redshift)
# Supports: toggle-nightlight [on|off|toggle] [--silent]
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.gemini/antigravity-cli/bin:$HOME/.local/bin:$PATH"

STATE_FILE="/tmp/nightlight_state"
TEMP_FILE="$HOME/.config/nightlight_temp"
MANUAL_OVERRIDE_FILE="/tmp/nightlight_manual_override"

CURRENT_TEMP=4200
if [[ -f "$TEMP_FILE" ]]; then
    CURRENT_TEMP=$(cat "$TEMP_FILE" 2>/dev/null)
elif [[ -f "/tmp/nightlight_temp" ]]; then
    CURRENT_TEMP=$(cat "/tmp/nightlight_temp" 2>/dev/null)
fi

ACTION="${1:-toggle}"
SILENT=0
for arg in "$@"; do
    if [[ "$arg" == "--silent" ]]; then
        SILENT=1
    elif [[ "$arg" == "on" || "$arg" == "off" || "$arg" == "toggle" ]]; then
        ACTION="$arg"
    fi
done

turn_on() {
    pkill -9 redshift >/dev/null 2>&1
    redshift -r -P -m randr -O "$CURRENT_TEMP" >/dev/null 2>&1
    echo "on" > "$STATE_FILE"
    if (( SILENT == 0 )); then
        echo "manual_on" > "$MANUAL_OVERRIDE_FILE"
    fi
    PERCENT=$(( (CURRENT_TEMP - 2000) * 100 / 4500 ))
    echo "$PERCENT" > /tmp/xobpipe 2>/dev/null || true
    if (( SILENT == 0 )); then
        notify-send -h string:x-canonical-private-synchronous:nightlight -h int:value:"$PERCENT" -t 1500 -i preferences-desktop-display "Night Light" "Enabled (${CURRENT_TEMP}K)"
    fi
}

turn_off() {
    pkill -9 redshift >/dev/null 2>&1
    redshift -x -m randr >/dev/null 2>&1
    xrandr --output eDP-1 --gamma 1.0:1.0:1.0 --brightness 1.0 >/dev/null 2>&1 || true
    echo "off" > "$STATE_FILE"
    if (( SILENT == 0 )); then
        echo "manual_off" > "$MANUAL_OVERRIDE_FILE"
    fi
    echo "0" > /tmp/xobpipe 2>/dev/null || true
    if (( SILENT == 0 )); then
        notify-send -h string:x-canonical-private-synchronous:nightlight -h int:value:0 -t 1500 -i preferences-desktop-display "Night Light" "Disabled (6500K Normal)"
    fi
}

case "$ACTION" in
    on)
        turn_on
        ;;
    off)
        turn_off
        ;;
    toggle|*)
        if [[ -f "$STATE_FILE" ]] && [[ "$(cat "$STATE_FILE")" == "on" ]]; then
            turn_off
        else
            turn_on
        fi
        ;;
esac
