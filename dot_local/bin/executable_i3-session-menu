#!/usr/bin/env bash
# Rofi menu for i3 session management
export PATH="$HOME/.local/bin:$PATH"

options="💾 Save Current Workspace\n🔄 Restore Current Workspace\n💾 Save All Workspaces\n🔄 Restore All Workspaces\n📋 List Saved Sessions\n🗑️ Delete Saved Sessions"

chosen=$(echo -e "$options" | rofi -dmenu -i -p "Session Manager")

case "$chosen" in
    *"Save Current Workspace"*)
        ~/.local/bin/i3-session-save
        ;;
    *"Restore Current Workspace"*)
        ~/.local/bin/i3-session-restore
        ;;
    *"Save All Workspaces"*)
        ~/.local/bin/i3-session-save --all
        ;;
    *"Restore All Workspaces"*)
        ~/.local/bin/i3-session-restore --all
        ;;
    *"List Saved Sessions"*)
        saved=$(i3-resurrect ls 2>/dev/null)
        [ -z "$saved" ] && saved="No saved sessions"
        echo "$saved" | rofi -dmenu -i -p "Saved Sessions"
        ;;
    *"Delete Saved Sessions"*)
        confirm=$(echo -e "No\nYes, delete all saved sessions" | rofi -dmenu -i -p "Are you sure?")
        if [[ "$confirm" == *"Yes"* ]]; then
            rm -rf ~/.i3/i3-resurrect/*
            command -v notify-send >/dev/null && notify-send -i edit-delete "i3 Session" "All saved sessions deleted"
        fi
        ;;
esac
