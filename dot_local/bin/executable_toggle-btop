#!/usr/bin/env bash
# ==============================================================================
# toggle-btop: Single-instance launcher / focuser / toggler for btop in Alacritty
# ==============================================================================
export DISPLAY="${DISPLAY:-:0}"
export PATH="$HOME/.local/bin:$PATH"

# Check if btop window already exists in tree (Sway or i3)
IPC_CMD="i3-msg"
[ -n "$SWAYSOCK" ] && IPC_CMD="swaymsg"

if $IPC_CMD -t get_tree 2>/dev/null | grep -q '"class":"btop"'; then
    # If focused, hide or close it; if not focused, focus it
    FOCUSED_CLASS=$($IPC_CMD -t get_tree 2>/dev/null | jq -r '.. | objects | select(.focused? == true) | .window_properties.class // empty')
    if [ "$FOCUSED_CLASS" = "btop" ]; then
        $IPC_CMD '[class="^btop$"] kill' >/dev/null 2>&1
    else
        $IPC_CMD '[class="^btop$"] focus' >/dev/null 2>&1
    fi
else
    # Not running: spawn single instance in floating Alacritty
    exec alacritty --class btop -e btop
fi
